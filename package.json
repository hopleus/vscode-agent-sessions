{
  "name": "hopl-agent-sessions",
  "displayName": "HOPL Agent Sessions",
  "description": "All your Claude Code, Codex and OpenCode sessions in one panel. Resume any conversation with one click.",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1f2430",
    "theme": "dark"
  },
  "version": "0.5.0",
  "publisher": "hopleus",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hopleus/vscode-agent-sessions.git"
  },
  "bugs": {
    "url": "https://github.com/hopleus/vscode-agent-sessions/issues"
  },
  "homepage": "https://github.com/hopleus/vscode-agent-sessions#readme",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agent-sessions",
          "title": "Agent Sessions",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "agent-sessions": [
        {
          "type": "webview",
          "id": "agentSessions.view",
          "name": "Agent Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "agentSessions.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Agent Sessions"
      },
      {
        "command": "agentSessions.refreshLimits",
        "title": "Refresh Usage Limits",
        "category": "Agent Sessions"
      },
      {
        "command": "agentSessions.session.pin",
        "title": "Pin",
        "category": "Agent Sessions"
      },
      {
        "command": "agentSessions.session.unpin",
        "title": "Unpin",
        "category": "Agent Sessions"
      },
      {
        "command": "agentSessions.session.rename",
        "title": "Rename...",
        "category": "Agent Sessions"
      },
      {
        "command": "agentSessions.session.reopenWithChrome",
        "title": "Reopen with Chrome",
        "category": "Agent Sessions"
      },
      {
        "command": "agentSessions.session.reopenWithoutChrome",
        "title": "Reopen without Chrome",
        "category": "Agent Sessions"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agentSessions.refresh",
          "when": "view == agentSessions.view",
          "group": "navigation"
        }
      ],
      "webview/context": [
        {
          "command": "agentSessions.session.pin",
          "when": "webviewId == 'agentSessions.view' && webviewSection == 'agentSessions.session' && !sessionPinned",
          "group": "1_pin@1"
        },
        {
          "command": "agentSessions.session.unpin",
          "when": "webviewId == 'agentSessions.view' && webviewSection == 'agentSessions.session' && sessionPinned",
          "group": "1_pin@1"
        },
        {
          "command": "agentSessions.session.rename",
          "when": "webviewId == 'agentSessions.view' && webviewSection == 'agentSessions.session'",
          "group": "2_edit@1"
        },
        {
          "command": "agentSessions.session.reopenWithChrome",
          "when": "webviewId == 'agentSessions.view' && webviewSection == 'agentSessions.session' && sessionAgent == 'claude' && !sessionChrome",
          "group": "3_reopen@1"
        },
        {
          "command": "agentSessions.session.reopenWithoutChrome",
          "when": "webviewId == 'agentSessions.view' && webviewSection == 'agentSessions.session' && sessionAgent == 'claude' && sessionChrome",
          "group": "3_reopen@1"
        }
      ],
      "commandPalette": [
        {
          "command": "agentSessions.session.pin",
          "when": "false"
        },
        {
          "command": "agentSessions.session.unpin",
          "when": "false"
        },
        {
          "command": "agentSessions.session.rename",
          "when": "false"
        },
        {
          "command": "agentSessions.session.reopenWithChrome",
          "when": "false"
        },
        {
          "command": "agentSessions.session.reopenWithoutChrome",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Agent Sessions",
      "properties": {
        "agentSessions.agents": {
          "type": "array",
          "default": [],
          "description": "Agent overrides: id, name, command, enabled. Merged with the built-in Claude, Codex and OpenCode.",
          "scope": "application"
        },
        "agentSessions.claudeProjectsPath": {
          "type": "string",
          "default": "",
          "description": "Path to Claude Code projects directory. Empty = ~/.claude/projects"
        },
        "agentSessions.limits.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show the usage limits item in the status bar. When turned off, nothing is added to the status bar and no usage data is collected (Codex session files are not scanned, Claude is not contacted)."
        },
        "agentSessions.limits.claude.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "markdownDescription": "Show Claude Code usage limits (5-hour and weekly) in the status bar tooltip. When enabled, the extension reads your Claude Code login from the macOS Keychain or `~/.claude/.credentials.json` and asks `api.anthropic.com` for your usage. The token is only used for this request and is never stored or logged. The endpoint is not officially documented and may change."
        },
        "agentSessions.limits.refreshMinutes": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "maximum": 60,
          "markdownDescription": "How often usage limits are refreshed, in minutes. Claude usage is requested from `api.anthropic.com` at this interval while the window is focused; after errors or rate limiting the interval grows automatically."
        },
        "agentSessions.limits.statusBarWindow": {
          "type": "string",
          "enum": [
            "first",
            "highest"
          ],
          "default": "first",
          "enumDescriptions": [
            "The agent's first limit window (for Claude, the 5-hour window).",
            "The most used limit window of the agent."
          ],
          "markdownDescription": "Which usage limit window the status bar item shows. The text and the warning or error background follow it."
        },
        "agentSessions.limits.warningPercent": {
          "type": "number",
          "default": 80,
          "minimum": 0,
          "maximum": 100,
          "markdownDescription": "Used percentage of the limit shown in the status bar from which the status bar item gets the warning background (yellow or orange, depends on the theme)."
        },
        "agentSessions.limits.errorPercent": {
          "type": "number",
          "default": 95,
          "minimum": 0,
          "maximum": 100,
          "markdownDescription": "Used percentage of the limit shown in the status bar from which the status bar item gets the error background (red, depends on the theme). Should not be lower than the warning percentage."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "vendor": "mkdir -p media/vendor && cp node_modules/@vscode/codicons/dist/codicon.css node_modules/@vscode/codicons/dist/codicon.ttf media/vendor/",
    "typecheck": "tsc -p ./ --noEmit && tsc -p tsconfig.webview.json",
    "build:webview": "esbuild src/webview/main.ts --bundle --format=iife --target=es2020 --loader:.svg=text --minify --outfile=media/dist/main.js",
    "compile": "rm -rf out dist media/dist && npm run vendor && npm run typecheck && npm run build:extension && npm run build:webview",
    "watch": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node22 --external:vscode --external:node:sqlite --minify --sourcemap --outfile=dist/extension.js --watch",
    "watch:webview": "esbuild src/webview/main.ts --bundle --format=iife --target=es2020 --loader:.svg=text --minify --outfile=media/dist/main.js --watch",
    "test": "tsc -p ./ && node --test \"out/**/*.test.js\"",
    "package": "vsce package",
    "build:extension": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node22 --external:vscode --external:node:sqlite --minify --sourcemap --outfile=dist/extension.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lobehub/icons-static-svg": "^1.95.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.0.0",
    "@types/vscode": "1.101.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "simple-icons": "^16.34.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.71.1"
  },
  "dependencies": {
    "@vscode-elements/elements": "^2.5.1",
    "@vscode/codicons": "^0.0.45"
  },
  "keywords": [
    "claude",
    "claude code",
    "codex",
    "ai",
    "agent",
    "sessions",
    "chat history",
    "resume"
  ]
}
